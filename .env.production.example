# Production template. Copy to the deployment secret store, not to source control.

ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=sysassist.example.com
ReverseProxy__TrustForwardedHeaders=true
SYSASSIST_WEB_PORT=8080

SysAssist__UseDemoData=false
SysAssist__ApplyMigrationsOnStartup=false
SysAssist__ForceEnableModulesOnStartup=false
SysAssist__ResetBootstrapAdminPasswordOnStartup=false
SysAssist__BootstrapAdminPassword=replace-with-bootstrap-secret-then-rotate
SYSASSIST_SMOKE_ADMIN_PASSWORD=replace-with-bootstrap-secret-then-rotate

ConnectionStrings__SysAssistDb=Host=replace-cockroach-host;Port=26257;Database=sysassist;Username=replace-user;Password=replace-password;SSL Mode=Require
ConnectionStrings__DefaultConnection=Host=replace-cockroach-host;Port=26257;Database=sysassist;Username=replace-user;Password=replace-password;SSL Mode=Require

Cors__AllowedOrigins__0=https://sysassist.example.com

Auth__JwtSecret=replace-with-long-random-jwt-secret-at-least-32-characters
Jwt__Issuer=SysAssist
Jwt__Audience=sysassist-api

Security__SecretEncryptionKey=replace-with-base64-32-byte-key
Security__RequireEncryptionInRealMode=true
Security__AllowDevelopmentJwtFallback=false
Security__MaxRequestBodyBytes=1048576

RateLimiting__Auth__PermitLimit=10
RateLimiting__Auth__WindowMinutes=1
RateLimiting__Webhooks__PermitLimit=240
RateLimiting__Webhooks__WindowMinutes=1
RateLimiting__Writes__PermitLimit=90
RateLimiting__Writes__WindowMinutes=1

Diagnostics__HealthStaleAfterMinutes=30

Licensing__PublicKey=replace-with-base64-ecdsa-p256-spki-public-key
Licensing__LicenseKey=replace-with-signed-license-token
Licensing__AllowDevelopmentBypass=false

# Enable only modules with working production endpoints and credentials.
SYSASSIST_MODULE_GRAFANA_BASEURL=https://grafana.example.com
SYSASSIST_MODULE_ZABBIX_BASEURL=https://zabbix.example.com
SYSASSIST_MODULE_PROMETHEUS_ALERTMANAGER_PROMETHEUSBASEURL=https://prometheus.example.com
SYSASSIST_MODULE_PROMETHEUS_ALERTMANAGER_ALERTMANAGERBASEURL=https://alertmanager.example.com
SYSASSIST_MODULE_HTTP_ENDPOINT_ENDPOINTURL=https://prometheus.example.com/-/healthy
SYSASSIST_MODULE_NGINX_BASEURL=https://nginx.example.com
SYSASSIST_MODULE_NGINX_STATUSURL=https://nginx.example.com/nginx_status
SYSASSIST_MODULE_TELEGRAM_BOT_BOTTOKEN=replace-with-botfather-token
SYSASSIST_MODULE_TELEGRAM_BOT_DEFAULTCHATID=replace-with-allowed-chat-id
TELEGRAM_BOT_AUTO_REGISTER_FIRST_CHAT=false
TELEGRAM_BOT_ALLOWED_CHAT_IDS=replace-with-allowed-chat-id
