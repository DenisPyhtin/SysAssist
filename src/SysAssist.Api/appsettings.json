{
  "AllowedHosts": "*",
  "SysAssist": {
    "UseDemoData": false,
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Jwt": {
    "Issuer": "SysAssist",
    "Audience": "sysassist-api",
    "ExpirationMinutes": 120
  },
  "Security": {
    "RequireEncryptionInRealMode": true,
    "AllowDevelopmentJwtFallback": false,
    "MaxRequestBodyBytes": 1048576
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    },
    "Webhooks": {
      "PermitLimit": 240,
      "WindowMinutes": 1
    },
    "Writes": {
      "PermitLimit": 90,
      "WindowMinutes": 1
    }
  },
  "Diagnostics": {
    "HealthStaleAfterMinutes": 30
  },
  "Licensing": {
    "AllowDevelopmentBypass": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
