# Copy values into your shell or CI variables. Do not commit a real .env file.

PROJECT_ID=your-gcp-project-id
PROJECT_NUMBER=000000000000
REGION=us-central1
ARTIFACT_REPOSITORY=sysassist
API_SERVICE=sysassist-api
WEB_SERVICE=sysassist-web

# Artifact Registry image names.
API_IMAGE=us-central1-docker.pkg.dev/your-gcp-project-id/sysassist/sysassist-api:latest
WEB_IMAGE=us-central1-docker.pkg.dev/your-gcp-project-id/sysassist/sysassist-web:latest

# Public URLs are known after first deploy.
API_URL=https://sysassist-api-REPLACE.a.run.app
WEB_URL=https://sysassist-web-REPLACE.a.run.app

# Secret Manager secret names.
COCKROACH_CONNECTION_STRING_SECRET=COCKROACH_CONNECTION_STRING
JWT_SECRET_NAME=JWT_SECRET
ZABBIX_API_TOKEN_SECRET=ZABBIX_API_TOKEN
GRAFANA_API_TOKEN_SECRET=GRAFANA_API_TOKEN
TELEGRAM_BOT_TOKEN_SECRET=TELEGRAM_BOT_TOKEN
SMTP_PASSWORD_SECRET=SMTP_PASSWORD
