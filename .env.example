# Copy to .env and keep the real file out of source control.

ASPNETCORE_ENVIRONMENT=Development
ReverseProxy__TrustForwardedHeaders=false
SysAssist__UseDemoData=false
SysAssist__ApplyMigrationsOnStartup=true
SysAssist__ForceEnableModulesOnStartup=false
SysAssist__ResetBootstrapAdminPasswordOnStartup=false
SysAssist__BootstrapAdminPassword=CHANGE-ME-generate-a-strong-bootstrap-password-123!
SYSASSIST_SMOKE_ADMIN_PASSWORD=CHANGE-ME-generate-a-strong-bootstrap-password-123!

ConnectionStrings__SysAssistDb=Host=localhost;Port=26257;Database=sysassist;Username=root;Password=;SSL Mode=Disable
ConnectionStrings__DefaultConnection=Host=localhost;Port=26257;Database=sysassist;Username=root;Password=;SSL Mode=Disable

Auth__JwtSecret=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=SysAssist
Jwt__Audience=sysassist-api
Security__SecretEncryptionKey=replace-with-base64-32-byte-key
Security__RequireEncryptionInRealMode=true
Security__AllowDevelopmentJwtFallback=false
Security__MaxRequestBodyBytes=1048576

RateLimiting__Auth__PermitLimit=30
RateLimiting__Auth__WindowMinutes=1
RateLimiting__Webhooks__PermitLimit=600
RateLimiting__Webhooks__WindowMinutes=1
RateLimiting__Writes__PermitLimit=180
RateLimiting__Writes__WindowMinutes=1
Diagnostics__HealthStaleAfterMinutes=30

Licensing__PublicKey=replace-with-base64-ecdsa-p256-spki-public-key
Licensing__LicenseKey=replace-with-signed-license-token
Licensing__AllowDevelopmentBypass=false

SYSASSIST_MODULE_GRAFANA_BASEURL=http://34.107.8.65:3000
SYSASSIST_MODULE_ZABBIX_BASEURL=http://34.107.8.65:10051
SYSASSIST_MODULE_PROMETHEUS_ALERTMANAGER_PROMETHEUSBASEURL=http://34.107.8.65:9090
SYSASSIST_MODULE_PROMETHEUS_ALERTMANAGER_ALERTMANAGERBASEURL=http://34.107.8.65:9093
SYSASSIST_MODULE_POSTGRESQL_HOST=34.107.8.65
SYSASSIST_MODULE_POSTGRESQL_PORT=5432
SYSASSIST_MODULE_POSTGRESQL_DATABASENAME=sysassistant_infra
SYSASSIST_MODULE_POSTGRESQL_USERNAME=sysadmin
SYSASSIST_MODULE_POSTGRESQL_CONNECTIONSTRING=postgresql://sysadmin:replace-password@34.107.8.65:5432/sysassistant_infra
SYSASSIST_MODULE_REDIS_REDISURL=redis://34.107.8.65:6379
SYSASSIST_MODULE_REDIS_HOST=34.107.8.65
SYSASSIST_MODULE_REDIS_PORT=6379
SYSASSIST_MODULE_HTTP_ENDPOINT_ENDPOINTURL=http://34.107.8.65:9090/-/healthy
SYSASSIST_MODULE_LINUX_HOST_HOSTNAME=34.107.8.65
SYSASSIST_MODULE_LINUX_HOST_AGENTBASEURL=http://34.107.8.65:9100/metrics
SYSASSIST_MODULE_NGINX_BASEURL=http://34.107.8.65:80
SYSASSIST_MODULE_NGINX_STATUSURL=http://34.107.8.65:80/nginx_status

# Optional modules not present in the workbook.
SYSASSIST_MODULE_DOCKER_DOCKERENDPOINT=
SYSASSIST_MODULE_FILE_SYSTEM_PATH=
SYSASSIST_MODULE_SMTP_EMAIL_SMTPHOST=
SYSASSIST_MODULE_SMTP_EMAIL_FROMEMAIL=
SYSASSIST_MODULE_TELEGRAM_BOT_BOTTOKEN=
SYSASSIST_MODULE_TELEGRAM_BOT_DEFAULTCHATID=
TELEGRAM_BOT_AUTO_REGISTER_FIRST_CHAT=true
TELEGRAM_BOT_ALLOWED_CHAT_IDS=
